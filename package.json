{
  "name": "stellar-mini-wallet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bindings": "stellar contract bindings typescript --wasm target/wasm32v1-none/release/mini_wallet.wasm --output-dir packages/mini-wallet-client --overwrite",
    "build:client": "tsc -p packages/mini-wallet-client/tsconfig.json",
    "predev": "npm run build:client",
    "dev": "vinext dev",
    "prebuild": "npm run build:client",
    "build": "vinext build",
    "start": "vinext start",
    "contract:test": "cargo test --locked --offline",
    "contract:build": "stellar contract build",
    "test": "npm run contract:test && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern packages/mini-wallet-client",
    "verify": "npm run lint && npm test"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "lucide-react": "^1.31.0",
    "mini-wallet-client": "file:packages/mini-wallet-client",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
